# ══════════════════════════════════════════════════════════════════════════════
# W'xOps Portal — Backend Environment Variables
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values for your environment.
# Real environment variables always take precedence over .env file values.
#
# Sections:
#   1. Server
#   2. OIDC / Pinniped Supervisor
#   3. Session
#   4. Cluster Registry
#   5. Service Catalog
# ══════════════════════════════════════════════════════════════════════════════


# ── 1. Server ──────────────────────────────────────────────────────────────────

# Port the backend HTTP server listens on.
PORT=8080

# Public URL of the Next.js frontend — used for CORS allow-origin.
# Must match exactly what the browser sends in the Origin header.
FRONTEND_URL=http://127.0.0.1:3000


# ── 2. OIDC / Pinniped Supervisor ─────────────────────────────────────────────
#
# The portal delegates all authentication to a Pinniped Supervisor
# FederationDomain. The Supervisor federates to your upstream IdP (Dex, Gitea
# OAuth2, etc.) and issues a single id_token that is valid for every spoke
# cluster — the "One Token" model.
#
# REQUIRED in all environments.

# Issuer URL of the Pinniped Supervisor FederationDomain.
# In-cluster example: https://pinniped-supervisor.pinniped-supervisor.svc.cluster.local
# External example:   https://sso.example.com
OIDC_ISSUER_URL=https://pinniped-supervisor.example.com

# OIDCClient name created in the Supervisor namespace.
# The value is the full resource name: client.oauth.pinniped.dev-<suffix>
# Run: kubectl get oidcclient -n pinniped-supervisor
OIDC_CLIENT_ID=client.oauth.pinniped.dev-wxops-portal

# Client secret from the OIDCClient's generated Secret. Only show for `kubectl create` commands, it won't be show second time and do not 
# expose as secrets because it will be hashed, so that requires create a new one when you lost it.
# Run:
# cat <<EOF | kubectl create -o yaml -f -
# apiVersion: clientsecret.supervisor.pinniped.dev/v1alpha1
# kind: OIDCClientSecretRequest
# metadata:
#   name: client.oauth.pinniped.dev-wxops-portal
#   namespace: pinniped-supervisor
# spec:
#   generateNewSecret: true
# EOF
OIDC_CLIENT_SECRET=your-oidc-client-secret-here

# OAuth2 redirect URI — must match the redirectURIs field in the OIDCClient CR.
# For local dev: http://127.0.0.1:3000/auth/callback (Pinniped requires callback match the pattern http(s)://<host>:<port>/auth/callback, so localhost won't work)
# only work with http scheme only for 127.0.0.1 (IPv4) or  ::1 (IPv6). Ref: https://github.com/vmware/pinniped/blob/main/generated/latest/README.adoc#oidcclientspec
# For production: https://portal.example.com/auth/callback
OIDC_REDIRECT_URI=http://127.0.0.1:3000/auth/callback

# Space-separated OIDC scopes (MUST match the scopes configured in the Supervisor's OIDCClient).
# pinniped:request-audience is required for the Hub-Spoke token exchange.
# Do not remove offline_access — it enables refresh tokens.
OIDC_SCOPES=openid,groups,offline_access,username,pinniped:request-audience

# ── Supervisor TLS (pick ONE option, leave all commented for public CA) ────────

# Option A — PEM file on disk (self-signed or private CA):
# OIDC_CA_BUNDLE_FILE=/etc/ssl/certs/supervisor-ca.pem

# Option B — inline PEM string (use literal \n as newline, useful in CI):
# OIDC_CA_BUNDLE=-----BEGIN CERTIFICATE-----\nMIIC...\n-----END CERTIFICATE-----

# Option C — skip TLS verification. DEV ONLY — never use in production.
# OIDC_TLS_SKIP_VERIFY=true


# ── 3. Session ─────────────────────────────────────────────────────────────────
#
# AES-256-GCM key used to encrypt the wxops_session cookie.
# REQUIRED. Must be exactly 64 lowercase hex characters (32 bytes).
# Generate a new key: openssl rand -hex 32
SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32


# ── 4. Cluster Registry ────────────────────────────────────────────────────────
#
# Controls how the portal discovers spoke clusters.
# Choose ONE of the three options below.

# ── Option A: Static JSON file (recommended for local development) ─────────────
#
# Path to a clusters.json file. When set, no hub cluster connection is needed.
# File schema: { "clusters": [{ "id", "name", "api_server",
#               "ca_bundle_base64" | "ca_bundle_file" | "ca_bundle",
#               "audience", "jwt_authenticator_name", "issuer_url",
#               "concierge_endpoint", "upstream_idp_name", "upstream_idp_type" }] }
# See: clusters.example.json for the full annotated reference.
#
CLUSTERS_CONFIG_FILE=./clusters.json

# ── Option B: Inline JSON (useful in CI / container envs without extra files) ───
#
# Same schema as the file, passed as a JSON string.
# CLUSTERS_CONFIG={"clusters":[{"id":"dev","name":"Dev","api_server":"https://127.0.0.1:6443","ca_bundle_file":"/home/user/.kube/ca.crt","audience":"dev","jwt_authenticator_name":"dev-jwt"}]}

# ── Option C: Kubernetes Secret discovery (production / GitOps) ──────────────
#
# When neither CLUSTERS_CONFIG_FILE nor CLUSTERS_CONFIG is set, the portal reads
# cluster registrations from Secrets labelled wxops.io/kind=cluster in the hub
# cluster namespace. Requires the portal's ServiceAccount to have Secret read
# access in that namespace (see Helm RBAC templates in README).
#
# Path to a kubeconfig for the hub cluster.
# Leave empty (or unset) when running inside the hub cluster — in-cluster config
# is used automatically via the mounted ServiceAccount token.
# KUBECONFIG=/path/to/hub-kubeconfig

# Namespace where cluster Secrets live. Default: wxops-system
# CLUSTER_NAMESPACE=wxops-system


# ── 5. Service Catalog ─────────────────────────────────────────────────────────
#
# The catalog reads Backstage-compatible catalog-info.yaml entity files and
# serves them via /api/v1/catalog/entities.
#
# Choose ONE option. Priority: LOCAL > GITEA > (none → 502 with hint).

# ── Option A: Local filesystem (development / testing) ────────────────────────
#
# Points the catalog at a local directory containing kind subdirectories:
#   <dir>/components/*.yaml
#   <dir>/apis/*.yaml
#   <dir>/systems/*.yaml
#   <dir>/groups/*.yaml
#   <dir>/resources/*.yaml
#
# Use the bundled examples to validate the UI before wiring a real Gitea repo:
CATALOG_LOCAL_DIR=./internal/catalog/examples
#
# Note: GITEA_CATALOG_PATH is ignored when CATALOG_LOCAL_DIR is set.
# The store always looks for kind dirs (components/, apis/, ...) directly
# at the root of CATALOG_LOCAL_DIR — no path prefix is applied.

# ── Option B: Gitea repository (production) ───────────────────────────────────
#
# Unset CATALOG_LOCAL_DIR and fill in the four GITEA_* vars below.

# Base URL of your Gitea instance (no trailing slash).
# GITEA_URL=https://gitea.example.com

# Personal access token with "repository" read scope.
# Generate at: <your-gitea>/user/settings/applications
# In production, inject this from a Kubernetes Secret — do not commit the value.
# GITEA_TOKEN=your-gitea-token-here

# Org or user that owns the gitops-infra repository.
# GITEA_CATALOG_OWNER=platform

# Repository name that contains the catalog directory.
# Default value shown — change if your repo is named differently.
# GITEA_CATALOG_REPO=gitops-infra

# Path within the repo where the kind subdirectories live.
# Default: catalog  →  gitops-infra/catalog/components/*.yaml etc.
# GITEA_CATALOG_PATH=catalog

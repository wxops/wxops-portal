{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Internal developer platform API — service catalog, Kubernetes cluster management, and OIDC authentication via Pinniped.",
        "title": "WxOps Portal API",
        "contact": {
            "name": "Platform Team",
            "url": "https://wxops.cloud"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/api/v1/catalog/entities": {
            "get": {
                "security": [
                    {
                        "CookieAuth": []
                    }
                ],
                "description": "Returns all catalog entities. Use ?kind= to filter by entity kind (case-insensitive).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "catalog"
                ],
                "summary": "List catalog entities",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Filter by kind (Component, API, System, Group, Resource, User, Doc)",
                        "name": "kind",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "entities array",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/catalog/entities/{kind}/{name}": {
            "get": {
                "security": [
                    {
                        "CookieAuth": []
                    }
                ],
                "description": "Returns a single catalog entity by kind and name.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "catalog"
                ],
                "summary": "Get catalog entity",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Entity kind (Component, API, System, Group, Resource, User, Doc)",
                        "name": "kind",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Entity name",
                        "name": "name",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/catalog.Entity"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/catalog/entities/{kind}/{name}/content": {
            "get": {
                "security": [
                    {
                        "CookieAuth": []
                    }
                ],
                "description": "Returns the raw Markdown content for a Doc entity. Fetches from spec.contentUrl via the Gitea client or the local reader.",
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "catalog"
                ],
                "summary": "Get document content",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Must be Doc",
                        "name": "kind",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Document name",
                        "name": "name",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Markdown content",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/catalog/entities/{kind}/{name}/spec": {
            "get": {
                "security": [
                    {
                        "CookieAuth": []
                    }
                ],
                "description": "Returns the raw OpenAPI/AsyncAPI spec for an API entity. Resolves from inline definition or an openapi-typed link URL.",
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "catalog"
                ],
                "summary": "Get API spec",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Entity kind (usually API)",
                        "name": "kind",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Entity name",
                        "name": "name",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Raw OpenAPI YAML or JSON",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/auth/callback": {
            "get": {
                "description": "Exchanges the authorization code for tokens, validates the id_token, and writes an encrypted session cookie.",
                "tags": [
                    "auth"
                ],
                "summary": "OIDC callback",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Authorization code",
                        "name": "code",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "CSRF state token",
                        "name": "state",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "302": {
                        "description": "Redirect to dashboard",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/auth/login": {
            "get": {
                "description": "Redirects the browser to the Pinniped Supervisor authorization endpoint to begin the PKCE flow.",
                "tags": [
                    "auth"
                ],
                "summary": "Start OIDC login",
                "responses": {
                    "302": {
                        "description": "Redirect to OIDC provider",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/auth/logout": {
            "post": {
                "description": "Clears the session cookie, effectively logging the user out.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Sign out",
                "responses": {
                    "200": {
                        "description": "message: logged out",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/auth/me": {
            "get": {
                "security": [
                    {
                        "CookieAuth": []
                    }
                ],
                "description": "Returns sub, username, and group memberships from the session. Available on both /auth/me (unauthenticated, for Next.js SSR) and /api/v1/me (protected).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Current user identity",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.userResponsePayload"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/healthz": {
            "get": {
                "description": "Returns 200 as long as the process is alive. Used by the Kubernetes liveness and startup probes.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Liveness probe",
                "responses": {
                    "200": {
                        "description": "status: ok",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/readyz": {
            "get": {
                "description": "Returns 200 when the server is ready to accept traffic. Kept separate from /healthz so probes can be tuned independently.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Readiness probe",
                "responses": {
                    "200": {
                        "description": "status: ok",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "catalog.Entity": {
            "type": "object",
            "properties": {
                "apiVersion": {
                    "description": "backstage.io/v1alpha1 (standard kinds) | wxops.cloud/v1alpha1 (Doc)",
                    "type": "string"
                },
                "kind": {
                    "description": "Component | API | System | Group | Resource | User | Doc",
                    "type": "string"
                },
                "metadata": {
                    "$ref": "#/definitions/catalog.EntityMetadata"
                },
                "spec": {
                    "$ref": "#/definitions/catalog.EntitySpec"
                }
            }
        },
        "catalog.EntityLink": {
            "type": "object",
            "properties": {
                "icon": {
                    "description": "Icon is a hint to the frontend (docs | dashboard | api | runbook | alert).",
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                },
                "url": {
                    "type": "string"
                }
            }
        },
        "catalog.EntityMetadata": {
            "type": "object",
            "properties": {
                "annotations": {
                    "description": "Annotations carry tool-specific metadata.\nExample: \"gitea/source-location\": \"platform/payments-service\"",
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "description": {
                    "type": "string"
                },
                "labels": {
                    "description": "Labels are free-form key/value pairs for filtering.",
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "links": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/catalog.EntityLink"
                    }
                },
                "name": {
                    "description": "Name is the unique identifier within the entity's kind and namespace.\nUsed in API paths: /catalog/entities/Component/payments-service",
                    "type": "string"
                },
                "namespace": {
                    "description": "defaults to \"default\"",
                    "type": "string"
                },
                "tags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "title": {
                    "type": "string"
                }
            }
        },
        "catalog.EntitySpec": {
            "type": "object",
            "properties": {
                "author": {
                    "description": "Author is the user ref who authored this document.\nFormat: \"user:alice\"",
                    "type": "string"
                },
                "children": {
                    "description": "Children lists sub-group refs.",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "consumesApis": {
                    "description": "ConsumesApis lists API entity refs consumed by this component.",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "contentUrl": {
                    "description": "ContentURL is the Gitea raw URL for the markdown source file.",
                    "type": "string"
                },
                "definition": {
                    "description": "── API ──────────────────────────────────────────────────────────────\nDefinition holds the raw API spec (OpenAPI YAML, AsyncAPI, etc.)\nTypically left empty here and fetched from the repo link instead.",
                    "type": "string"
                },
                "dependsOn": {
                    "description": "DependsOn lists component or resource refs this entity depends on.\nFormat: \"component:default/user-service\", \"resource:default/payments-db\"",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "docStatus": {
                    "description": "DocStatus is the review lifecycle: proposed | under-review | accepted | deprecated | superseded",
                    "type": "string"
                },
                "docType": {
                    "description": "── Doc ──────────────────────────────────────────────────────────────────\nDocType classifies the document: rfc | adr | documentation",
                    "type": "string"
                },
                "domain": {
                    "description": "── System ───────────────────────────────────────────────────────────",
                    "type": "string"
                },
                "email": {
                    "description": "Email is the user's contact address.",
                    "type": "string"
                },
                "lifecycle": {
                    "description": "Lifecycle is the maturity stage: experimental | production | deprecated",
                    "type": "string"
                },
                "memberOf": {
                    "description": "── User ─────────────────────────────────────────────────────────────────\nMemberOf lists group refs this user belongs to.\nFormat: \"group:rocket-team\"",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "members": {
                    "description": "Members lists user refs that belong to this group.",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "owner": {
                    "description": "── Common across most kinds ─────────────────────────────────────────\nOwner is a group or user reference: \"group:platform-team\", \"user:alice\"",
                    "type": "string"
                },
                "parent": {
                    "description": "── Group ────────────────────────────────────────────────────────────\nParent is the parent group ref for nested org structures.",
                    "type": "string"
                },
                "providesApis": {
                    "description": "ProvidesApis lists API entity refs exposed by this component.",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "relatedTo": {
                    "description": "RelatedTo lists component/resource/API refs that this document describes.\nFormat: \"component:default/payments-service\"",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "supersededBy": {
                    "description": "SupersededBy is a Doc entity ref that replaces this document (e.g. RFC → ADR).\nFormat: \"doc:default/adr-001-kafka\"",
                    "type": "string"
                },
                "system": {
                    "description": "System groups related components under a named system.",
                    "type": "string"
                },
                "type": {
                    "description": "── Component ────────────────────────────────────────────────────────\nType classifies the component: service | website | library | pipeline | documentation",
                    "type": "string"
                }
            }
        },
        "handlers.userResponsePayload": {
            "type": "object",
            "properties": {
                "groups": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "sub": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "CookieAuth": {
            "description": "Encrypted session cookie issued after OIDC login.",
            "type": "apiKey",
            "name": "wxops_session",
            "in": "cookie"
        }
    }
}
# ══════════════════════════════════════════════════════════════════════════════
# W'xOps Portal — Frontend Environment Variables
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env.local and adjust as needed.
# This file is safe to commit — no secrets belong here.
# All variables here are server-side only (used by Next.js server components
# and route handlers). They are never exposed to the browser.
# ══════════════════════════════════════════════════════════════════════════════

# Internal URL of the Go backend reachable from the Next.js server process.
# For local dev:   http://localhost:8080
# In-cluster:      http://wxops-backend.wxops-system.svc.cluster.local:8080
# Docker Compose:  http://backend:8080
BACKEND_URL=http://localhost:8080

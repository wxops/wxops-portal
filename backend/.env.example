PORT=8080
FRONTEND_URL=http://127.0.0.1:3000

# Pinniped Supervisor FederationDomain issuer URL
OIDC_ISSUER_URL=https://pinniped-supervisor.example.com
OIDC_CLIENT_ID=created-client-id
OIDC_CLIENT_SECRET=get-generated-when-create-oidcsecret-request
OIDC_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
OIDC_SCOPES=openid,profile,email,groups,offline_access,pinniped:request-audience

# ── Supervisor TLS (choose ONE option, leave all unset for public CA) ──────────

# Option A — path to PEM file on disk (self-signed / private CA):
# OIDC_CA_BUNDLE_FILE=/path/to/supervisor-ca.pem

# Option B — inline PEM (use literal \n as line separator):
# OIDC_CA_BUNDLE=-----BEGIN CERTIFICATE-----\nMIIC...\n-----END CERTIFICATE-----

# Option C — skip TLS verification (DEV ONLY, never use in production):
# OIDC_TLS_SKIP_VERIFY=true

# ── Session ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=some-random-string-to-encrypt-session-data

# ── Hub cluster (GitOps / production) ─────────────────────────────────────────
# Path to kubeconfig for the hub cluster (leave empty for in-cluster config).
# Used only when CLUSTERS_CONFIG_FILE / CLUSTERS_CONFIG are NOT set.
KUBECONFIG=/path/to/your/kubeconfig
CLUSTER_NAMESPACE=namespace-where-list-clusters-are-stored

# ── Static cluster config (dev / testing — no hub cluster required) ────────────
# When set, Discovery from K8s Secrets is skipped entirely.
# File path takes priority over inline JSON when both are set.
#
# CLUSTERS_CONFIG_FILE=/path/to/clusters.json
#
# Or inline JSON (useful in CI or when you don't want a separate file):
# CLUSTERS_CONFIG={"clusters":[{"id":"dev","name":"Dev Cluster","api_server":"https://127.0.0.1:6443","ca_bundle_file":"/home/user/.kube/ca.crt","audience":"dev","jwt_authenticator_name":"dev-jwt-authenticator"}]}